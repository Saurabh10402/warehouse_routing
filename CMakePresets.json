{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 22,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Default development build",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/default",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "EALR_BUILD_TESTS": "ON",
        "EALR_ENABLE_NS3": "ON"
      }
    },
    {
      "name": "bootstrap",
      "displayName": "CMake bootstrap without ns-3",
      "inherits": "default",
      "binaryDir": "${sourceDir}/build/bootstrap",
      "cacheVariables": {
        "EALR_ENABLE_NS3": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default"
    },
    {
      "name": "bootstrap",
      "configurePreset": "bootstrap"
    }
  ],
  "testPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "bootstrap",
      "configurePreset": "bootstrap",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
